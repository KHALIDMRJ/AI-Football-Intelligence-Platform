# ─────────────────────────────────────────────────────────────────────────────
# Football AI Intelligence Platform — environment template
#
# Copy to .env (not committed) and fill real values.
# Loaded by football_ai.config.PlatformSettings (pydantic-settings).
# Docker Compose also reads this file for service-level config (Phase 10).
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ports ────────────────────────────────────────────────────────────
API_PORT=8000
DASHBOARD_PORT=8501
API_WORKERS=2

# ── Pipeline (CSV ingestion for VAEP/xT analytics) ───────────────────────────
INPUT_CSV=fus_FAR.csv

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production | test
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────────────────────
# Dev default (sqlite) runs zero-infra. Production uses postgres+asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./football_ai.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/football_ai
DATABASE_ECHO=false                  # log every SQL statement (dev only)

# ── Redis (Phase 6: caching, arq queue, live-match pub/sub) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT auth (Phase 3) ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-64-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14

# ── External APIs ────────────────────────────────────────────────────────────
# API-Football: https://dashboard.api-football.com — free tier = 100 calls/day
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Anthropic (scouting reports + tactical commentary, Phase 5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini server-side chat proxy. Do not expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ── Rate limiting by role (requests per day, -1 = unlimited) ─────────────────
QUOTA_FREE_USER_PER_DAY=100
QUOTA_PRO_ANALYST_PER_DAY=-1
QUOTA_CLUB_SCOUT_PER_DAY=-1
